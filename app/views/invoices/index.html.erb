<script>
  // Global Modal functions - MUST BE FIRST
  window.openWhatsAppInvoiceModal = function() {
    console.log('🔓 Opening WhatsApp Invoice modal');
    const modal = document.getElementById('generateWhatsAppInvoiceModal');
    if (modal) {
      modal.style.display = 'flex';
      document.body.classList.add('modal-open');
      document.body.style.overflow = 'hidden';

      // Focus on the first interactive element
      setTimeout(() => {
        const firstInput = modal.querySelector('select, input, button');
        if (firstInput) {
          firstInput.focus();
        }
      }, 100);
    } else {
      console.error('❌ WhatsApp Invoice modal element not found');
    }
  };

  window.closeWhatsAppInvoiceModal = function() {
    console.log('🔒 Closing WhatsApp Invoice modal');
    const modal = document.getElementById('generateWhatsAppInvoiceModal');
    if (modal) {
      modal.style.display = 'none';
      document.body.classList.remove('modal-open');
      document.body.style.overflow = '';
    }
  };

  window.openGenerateMonthlyModal = function() {
    console.log('🔓 Opening Generate Monthly modal');
    const modal = document.getElementById('generateMonthlyModal');
    if (modal) {
      modal.style.display = 'flex';
      document.body.classList.add('modal-open');
      document.body.style.overflow = 'hidden';

      // Load customers for the selected month/year
      setTimeout(() => {
        console.log('📊 Loading customers for monthly invoice generation...');
        loadCustomersForMonth();
      }, 200);

      // Focus on the first interactive element
      setTimeout(() => {
        const firstInput = modal.querySelector('select, input, button');
        if (firstInput) {
          firstInput.focus();
        }
      }, 300);
    } else {
      console.error('❌ Generate Monthly modal element not found');
    }
  };

  window.closeGenerateMonthlyModal = function() {
    console.log('🔒 Closing Generate Monthly modal');
    const modal = document.getElementById('generateMonthlyModal');
    if (modal) {
      modal.style.display = 'none';
      document.body.classList.remove('modal-open');
      document.body.style.overflow = '';
    }
  };

  // Global function to open WhatsApp directly without modal
  window.openWhatsAppDirect = function(button) {
    console.log('🚀 Opening WhatsApp directly');

    // Extract data from button
    const invoiceData = {
      id: button.dataset.invoiceId,
      number: button.dataset.invoiceNumber,
      customerName: button.dataset.customerName,
      customerPhone: button.dataset.customerPhone,
      customerId: button.dataset.customerId,
      amount: button.dataset.amount
    };

    console.log('📊 Invoice data:', invoiceData);

    // Validate phone number
    if (!invoiceData.customerPhone || invoiceData.customerPhone === 'null' || invoiceData.customerPhone === '') {
      alert('No phone number found for this customer. Please update customer details.');
      return;
    }

    // Show loading state
    button.disabled = true;
    const originalHtml = button.innerHTML;
    button.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

    // Make AJAX request to share_whatsapp endpoint
    fetch(`/invoices/${invoiceData.id}/share_whatsapp`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('[name="csrf-token"]').getAttribute('content')
      },
      body: JSON.stringify({
        phone_number: invoiceData.customerPhone
      })
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        // Open WhatsApp directly
        window.open(data.whatsapp_url, '_blank');
        // Show success message
        if (typeof showNotification === 'function') {
