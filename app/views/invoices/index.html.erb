<script>
// Mark as Completed Modal functionality
let currentInvoiceId = null;
function closeMarkCompletedModal() {
  console.log('🔒 Closing Mark Completed modal');
  
  const modal = document.getElementById('markCompletedModal');
  if (modal) {
    modal.style.display = 'none';
    document.body.classList.remove('modal-open');
    document.body.style.overflow = '';
  }

  // Reset state
  currentInvoiceId = null;
  const checkbox = document.getElementById('paymentConfirmation');
  if (checkbox) checkbox.checked = false;
  const confirmBtn = document.getElementById('confirmMarkCompleted');
  if (confirmBtn) confirmBtn.disabled = true;
}

function openCompletedModal(button) {
  console.log('🔓 Opening Mark Completed modal');
  
  const invoiceId = button.getAttribute('data-invoice-id');
  const invoiceNumber = button.getAttribute('data-invoice-number');
  const customerName = button.getAttribute('data-customer-name');

  currentInvoiceId = invoiceId;

  // Update modal content
  document.getElementById('modalInvoiceNumber').textContent = invoiceNumber;
  document.getElementById('modalCustomerName').textContent = customerName;

  // Reset checkbox
  const checkbox = document.getElementById('paymentConfirmation');
  checkbox.checked = false;
  document.getElementById('confirmMarkCompleted').disabled = true;

  // Show modal using custom modal approach
  const modal = document.getElementById('markCompletedModal');
  if (modal) {
    modal.style.display = 'flex';
    document.body.classList.add('modal-open');
    document.body.style.overflow = 'hidden';

    // Focus on checkbox after a short delay
    setTimeout(() => {
      checkbox.focus();
    }, 300);
  }
}

// Enable/disable confirm button based on checkbox
document.getElementById('paymentConfirmation').addEventListener('change', function() {
  const confirmBtn = document.getElementById('confirmMarkCompleted');
  confirmBtn.disabled = !this.checked;
});

// Handle form submission
document.getElementById('confirmMarkCompleted').addEventListener('click', function() {
  if (!currentInvoiceId) return;

  const confirmBtn = this;
  const originalText = confirmBtn.innerHTML;

  // Show loading state
  confirmBtn.disabled = true;
  confirmBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Processing...';

  // Create and submit form
  const form = document.createElement('form');
  form.method = 'POST';
  form.action = `/invoices/${currentInvoiceId}/mark_as_completed`;

  // Add CSRF token
  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
  if (csrfToken) {
    const csrfInput = document.createElement('input');
    csrfInput.type = 'hidden';
    csrfInput.name = 'authenticity_token';
    csrfInput.value = csrfToken;
    form.appendChild(csrfInput);
  }

  // Add method override for PATCH
  const methodInput = document.createElement('input');
  methodInput.type = 'hidden';
  methodInput.name = '_method';
  methodInput.value = 'patch';
  form.appendChild(methodInput);

  document.body.appendChild(form);
  form.submit();
});

// Mobile responsive adjustments for the modal
function adjustModalForMobile() {
  const modal = document.querySelector('.custom-modal-content');
  if (modal) {
    if (window.innerWidth <= 768) {
      modal.style.width = '95%';
      modal.style.maxWidth = '95%';
      modal.style.margin = '20px auto';
    } else {
      modal.style.width = '';
      modal.style.maxWidth = '800px';
      modal.style.margin = '50px auto';
    }
  }
}

// Call on window resize
window.addEventListener('resize', adjustModalForMobile);
document.addEventListener('DOMContentLoaded', adjustModalForMobile);

// Delete Invoice Modal functionality
let currentDeleteInvoiceId = null;

// Global variable to store current delivery assignment ID being edited
var currentEditingDeliveryId = null;

function openDeleteModal(button) {
  const invoiceId = button.getAttribute('data-invoice-id');
  const invoiceNumber = button.getAttribute('data-invoice-number');
  const customerName = button.getAttribute('data-customer-name');
  const totalAmount = button.getAttribute('data-total-amount');

  currentDeleteInvoiceId = invoiceId;

  // Update modal content
  document.getElementById('deleteModalInvoiceNumber').textContent = invoiceNumber;
  document.getElementById('deleteModalCustomerName').textContent = customerName;
  document.getElementById('deleteModalAmount').textContent = '₹' + new Intl.NumberFormat('en-IN').format(totalAmount);

  // Reset input field
  const inputField = document.getElementById('deleteConfirmationInput');
  inputField.value = '';
  inputField.classList.remove('is-valid', 'is-invalid');
  document.getElementById('confirmDeleteInvoice').disabled = true;

  // Show enhanced custom modal
  const modal = document.getElementById('deleteInvoiceModal');
  modal.style.display = 'flex';
  document.body.classList.add('modal-open');

  // Focus on input field after modal is shown
  setTimeout(() => {
    inputField.focus();
  }, 300);
}

function closeDeleteInvoiceModal() {
  const modal = document.getElementById('deleteInvoiceModal');
  modal.style.display = 'none';
  document.body.classList.remove('modal-open');
  currentDeleteInvoiceId = null;
}

// Enable/disable delete button based on input
document.getElementById('deleteConfirmationInput').addEventListener('input', function() {
  const confirmBtn = document.getElementById('confirmDeleteInvoice');
  const inputValue = this.value.toLowerCase().trim();

  if (inputValue === 'delete') {
    confirmBtn.disabled = false;
    confirmBtn.classList.remove('btn-danger');
    confirmBtn.classList.add('btn-danger');
    this.classList.remove('is-invalid');
    this.classList.add('is-valid');
  } else {
    confirmBtn.disabled = true;
    this.classList.remove('is-valid');
    if (inputValue.length > 0) {
      this.classList.add('is-invalid');
    } else {
      this.classList.remove('is-invalid');
    }
  }
});

// Handle delete form submission
document.getElementById('confirmDeleteInvoice').addEventListener('click', function() {
  if (!currentDeleteInvoiceId) return;

  const confirmBtn = this;
  const originalText = confirmBtn.innerHTML;

  // Show loading state
  confirmBtn.disabled = true;
  confirmBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Deleting...';

  // Get CSRF token
  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');

  // Make AJAX request for better UX
  fetch(`/invoices/${currentDeleteInvoiceId}`, {
    method: 'DELETE',
    headers: {
      'Accept': 'application/json',
      'Content-Type': 'application/json',
      'X-CSRF-Token': csrfToken,
      'X-Requested-With': 'XMLHttpRequest'
    }
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      // Show success animation
      confirmBtn.innerHTML = '<i class="fas fa-check me-1"></i>Deleted!';
      confirmBtn.classList.remove('btn-danger');
      confirmBtn.classList.add('btn-success');

      // Show success message
      if (window.showSimpleToast) {
        window.showSimpleToast(data.message, 'success');
      } else {
        alert(data.message);
      }

      // Close modal after a brief delay
      setTimeout(() => {
        closeDeleteInvoiceModal();

        // Remove the invoice from the UI
        const invoiceRow = document.querySelector(`tr[data-invoice-id="${currentDeleteInvoiceId}"]`);
        if (invoiceRow) {
          invoiceRow.style.transition = 'all 0.3s ease';
          invoiceRow.style.opacity = '0';
          invoiceRow.style.transform = 'scale(0.95)';
          setTimeout(() => {
            invoiceRow.remove();
          }, 300);
        }

        // Or refresh the page if row removal doesn't work well
        setTimeout(() => {
          window.location.reload();
        }, 1000);
      }, 1500);

    } else {
      throw new Error(data.message || 'Failed to delete invoice');
    }
  })
  .catch(error => {
    console.error('Error deleting invoice:', error);

    // Show error message
    if (window.showSimpleToast) {
      window.showSimpleToast(`❌ Error: ${error.message}`, 'error');
    } else {
      alert(`Error deleting invoice: ${error.message}`);
    }

    // Reset button state
    confirmBtn.innerHTML = originalText;
    confirmBtn.disabled = false;
  });
});

// Mobile responsive adjustments for delete modal
function adjustDeleteModalForMobile() {
  const modal = document.getElementById('deleteInvoiceModal');
  if (modal) {
    const modalContent = modal.querySelector('.custom-modal-content');
    if (modalContent) {
      if (window.innerWidth < 768) {
        modalContent.classList.add('modal-fullscreen-sm-down');
      } else {
        modalContent.classList.remove('modal-fullscreen-sm-down');
      }
    }
  }
}

// Call on window resize for delete modal
