<script>
function openQuickInvoiceModal() {
  // Reset form and clear previous data
  resetQuickInvoiceForm();

  // Load products
  loadProducts();

  // Setup customer search functionality
  setupCustomerSearch();

  // Set today's date as default
  const deliveryDateElement = document.getElementById('deliveryDate');
  if (deliveryDateElement) {
    try {
      // Try using valueAsDate first
      if (deliveryDateElement.type === 'date') {
        deliveryDateElement.valueAsDate = new Date();
      } else {
        // Fallback to setting value as ISO string
        const today = new Date();
        deliveryDateElement.value = today.toISOString().split('T')[0];
      }
    } catch (error) {
      // Fallback method if valueAsDate fails
      const today = new Date();
      deliveryDateElement.value = today.toISOString().split('T')[0];
    }
  }

  // Show modal
  document.getElementById('quickInvoiceModal').style.display = 'block';
}

function closeQuickInvoiceModal() {
  document.getElementById('quickInvoiceModal').style.display = 'none';

  // Reset form
  document.getElementById('quickInvoiceForm').reset();
  document.getElementById('totalAmount').textContent = '0.00';

  // Clear products container
  document.getElementById('productsContainer').innerHTML = '';
  productRowCounter = 0;
}

function loadProducts() {
  fetch('/invoices/get_products')
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        // Store products globally for use in multiple product rows
        availableProducts = data.products;

        // Add initial product row after products are loaded
        addProductRow();
      }
    })
    .catch(error => {
      console.error('Error loading products:', error);
      alert('Error loading products. Please try again.');
    });
}

// Auto-fill rate when product is selected - removed since we now use dynamic product rows

// Customer search functionality
function setupCustomerSearch() {
  const customerInput = document.getElementById('customerInput');
  const customerDropdown = document.getElementById('customerDropdown');
  const customerSearchResults = document.getElementById('customerSearchResults');
  const selectedCustomerId = document.getElementById('selectedCustomerId');
  const customerPhone = document.getElementById('customerPhone');

  if (!customerInput) return;

  // Search customers as user types
  customerInput.addEventListener('input', function() {
    const query = this.value.trim();

    if (query.length >= 1) {
      searchCustomers(query);
    } else {
      customerDropdown.style.display = 'none';
      selectedCustomerId.value = '';
      customerPhone.value = '';
    }
  });

  // Hide dropdown when clicking outside
  document.addEventListener('click', function(e) {
    if (!customerInput.contains(e.target) && !customerDropdown.contains(e.target)) {
      customerDropdown.style.display = 'none';
    }
  });

  // Show dropdown when input is focused and has content
  customerInput.addEventListener('focus', function() {
    if (this.value.trim().length >= 1) {
      searchCustomers(this.value.trim());
    }
  });
}

function searchCustomers(query) {
  fetch(`/invoices/search_suggestions?q=${encodeURIComponent(query)}&page=1`)
    .then(response => response.json())
    .then(data => {
      const customerSearchResults = document.getElementById('customerSearchResults');
      const customerDropdown = document.getElementById('customerDropdown');

      if (data.suggestions && data.suggestions.length > 0) {
        const customerSuggestions = data.suggestions.filter(s => s.type === 'customer');

        customerSearchResults.innerHTML = '';

        if (customerSuggestions.length > 0) {
          customerSuggestions.forEach(customer => {
            const item = document.createElement('a');
            item.className = 'dropdown-item customer-option';
            item.href = '#';
            item.innerHTML = `
              <div class="d-flex justify-content-between">
                <span>${customer.label}</span>
                <small class="text-muted">${customer.phone || 'No phone'}</small>
              </div>
            `;

            item.addEventListener('click', function(e) {
              e.preventDefault();
              selectCustomer(customer.id, customer.label, customer.phone || '');
            });

            customerSearchResults.appendChild(item);
          });

          customerDropdown.style.display = 'block';
        } else {
          customerDropdown.style.display = 'none';
        }
      } else {
        customerDropdown.style.display = 'none';
      }
    })
    .catch(error => {
      console.error('Error searching customers:', error);
      document.getElementById('customerDropdown').style.display = 'none';
    });
}

function selectCustomer(customerId, customerName, customerPhone) {
  const customerInput = document.getElementById('customerInput');
  const selectedCustomerId = document.getElementById('selectedCustomerId');
  const customerPhoneInput = document.getElementById('customerPhone');
  const customerDropdown = document.getElementById('customerDropdown');

  customerInput.value = customerName;
  selectedCustomerId.value = customerId;
  customerPhoneInput.value = customerPhone;
  customerDropdown.style.display = 'none';
}

let productRowCounter = 0;
let availableProducts = [];

function addProductRow() {
  productRowCounter++;
  const container = document.getElementById('productsContainer');

  const productRow = document.createElement('div');
  productRow.className = 'product-row mb-3 p-3 border rounded';
  productRow.id = `productRow${productRowCounter}`;

  productRow.innerHTML = `
    <div class="d-flex justify-content-between align-items-center mb-2">
      <h6 class="mb-0">Product ${productRowCounter}</h6>
      <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeProductRow(${productRowCounter})">
        <i class="fas fa-trash"></i>
      </button>
    </div>

    <div class="row">
      <div class="col-md-6 mb-2">
        <label class="form-label">Product</label>
        <select class="form-select product-select" name="products[${productRowCounter}][product_id]" required>
          <option value="">Select Product...</option>
        </select>
      </div>
      <div class="col-md-6 mb-2">
        <label class="form-label">Quantity</label>
        <input type="number" class="form-control quantity-input" name="products[${productRowCounter}][quantity]"
               step="0.01" min="0.01" required onchange="calculateRowTotal(${productRowCounter})">
      </div>
      <div class="col-md-6 mb-2">
        <label class="form-label">Rate per Unit</label>
        <input type="number" class="form-control rate-input" name="products[${productRowCounter}][rate]"
               step="0.01" min="0.01" required onchange="calculateRowTotal(${productRowCounter})">
      </div>
      <div class="col-md-6 mb-2">
        <label class="form-label">Discount Amount</label>
        <input type="number" class="form-control discount-input" name="products[${productRowCounter}][discount_amount]"
               step="0.01" min="0" value="0" onchange="calculateRowTotal(${productRowCounter})">
      </div>
      <div class="col-12">
        <div class="text-end">
          <strong>Subtotal: ₹<span class="row-total" id="rowTotal${productRowCounter}">0.00</span></strong>
        </div>
      </div>
    </div>
  `;

  container.appendChild(productRow);

  // Populate product options for the new row
  const productSelect = productRow.querySelector('.product-select');
  availableProducts.forEach(product => {
    const option = document.createElement('option');
    option.value = product.id;
    option.textContent = `${product.name} (₹${product.price}/${product.unit_type})`;
    productSelect.appendChild(option);
  });

  // Auto-fill rate when product is selected
  productSelect.addEventListener('change', function() {
    const selectedProduct = availableProducts.find(p => p.id == this.value);
    if (selectedProduct) {
      const rateInput = productRow.querySelector('.rate-input');
      rateInput.value = selectedProduct.price;
      calculateRowTotal(productRowCounter);
    }
  });

  updateTotalAmount();
}

function removeProductRow(rowId) {
  const productRows = document.querySelectorAll('.product-row');
  if (productRows.length > 1) {
    document.getElementById(`productRow${rowId}`).remove();
    updateTotalAmount();
  } else {
    alert('At least one product is required.');
  }
}

function calculateRowTotal(rowId) {
  const row = document.getElementById(`productRow${rowId}`);
  const quantity = parseFloat(row.querySelector('.quantity-input').value) || 0;
  const rate = parseFloat(row.querySelector('.rate-input').value) || 0;
  const discount = parseFloat(row.querySelector('.discount-input').value) || 0;

  const subtotal = (quantity * rate) - discount;
  row.querySelector('.row-total').textContent = subtotal.toFixed(2);

  updateTotalAmount();
}

function updateTotalAmount() {
  const allRowTotals = document.querySelectorAll('.row-total');
  let grandTotal = 0;

  allRowTotals.forEach(totalElement => {
    grandTotal += parseFloat(totalElement.textContent) || 0;
  });

  const totalAmountElement = document.getElementById('totalAmount');
  if (totalAmountElement) {
    totalAmountElement.textContent = grandTotal.toFixed(2);
  }
}

function submitQuickInvoice() {
  const form = document.getElementById('quickInvoiceForm');
  const formData = new FormData(form);

  // Validate required fields
  const customerName = formData.get('customer_name');
  const customerId = formData.get('customer_id');

  if (!customerName && !customerId) {
    alert('Please enter a customer name or select an existing customer.');
    return;
  }

  if (!formData.get('delivery_date')) {
    alert('Please select a delivery date.');
    return;
  }

  // Collect products data
  const productRows = document.querySelectorAll('.product-row');
  const products = [];
  let hasValidProducts = true;

  productRows.forEach((row, index) => {
    const productId = row.querySelector('.product-select').value;
    const quantity = row.querySelector('.quantity-input').value;
    const rate = row.querySelector('.rate-input').value;
    const discount = row.querySelector('.discount-input').value || 0;

    if (!productId || !quantity || !rate) {
      hasValidProducts = false;
      alert(`Please complete all fields for Product ${index + 1}.`);
      return;
    }

    products.push({
      product_id: productId,
      quantity: quantity,
      rate: rate,
      discount_amount: discount
    });
  });

  if (!hasValidProducts || products.length === 0) {
    return;
  }

  // Show loading state
  const submitBtn = event.target;
  const originalText = submitBtn.innerHTML;
  submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Creating...';
  submitBtn.disabled = true;

  // Prepare data for submission
  const submitData = {
    customer_name: formData.get('customer_name'),
    customer_id: formData.get('customer_id'),
    customer_phone: formData.get('customer_phone'),
    delivery_date: formData.get('delivery_date'),
    delivery_person_id: formData.get('delivery_person_id'),
    products: products
  };

  fetch('/invoices/create_sidebar_invoice', {
    method: 'POST',
    headers: {
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
      'Content-Type': 'application/json'
    },
    body: JSON.stringify(submitData)
  })
  .then(response => response.json())
  .then(data => {
    submitBtn.innerHTML = originalText;
    submitBtn.disabled = false;

    if (data.success) {
      alert(`Invoice ${data.invoice_number} created successfully!`);
      closeQuickInvoiceModal();

      // Reload page to show new invoice
      window.location.reload();
    } else {
      alert(`Error: ${data.error}`);
    }
  })
  .catch(error => {
    submitBtn.innerHTML = originalText;
    submitBtn.disabled = false;
    console.error('Error:', error);
    alert('An error occurred while creating the invoice.');
  });
}

// Close modal with Escape key
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    closeQuickInvoiceModal();
  }
});

// Filter by status function for clickable cards
function filterByStatus(status) {
  // Remove active class from all cards
  document.querySelectorAll('.clickable-card').forEach(card => {
    card.classList.remove('active');
  });

  // Add active class to clicked card
  const clickedCard = document.querySelector(`[data-status="${status}"]`);
  if (clickedCard) {
    clickedCard.classList.add('active');
  }

  // Get current URL parameters
  const urlParams = new URLSearchParams(window.location.search);

  // Update or remove status parameter
  if (status === '') {
    urlParams.delete('status');
  } else {
    urlParams.set('status', status);
  }

  // Construct new URL
  const newUrl = window.location.pathname + (urlParams.toString() ? '?' + urlParams.toString() : '');

  // Navigate to new URL
  window.location.href = newUrl;
}

// Initialize active state on page load
document.addEventListener('DOMContentLoaded', function() {
  const urlParams = new URLSearchParams(window.location.search);
  const currentStatus = urlParams.get('status') || '';

  // Remove active class from all cards first
  document.querySelectorAll('.clickable-card').forEach(card => {
    card.classList.remove('active');
  });

  // Add active class to the current filter
  const activeCard = document.querySelector(`[data-status="${currentStatus}"]`);
  if (activeCard) {
    activeCard.classList.add('active');
  }
});
</script>
