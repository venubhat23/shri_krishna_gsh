// Function to save delivery assignment changes
function saveDeliveryAssignment() {
  if (!currentEditingDeliveryId) {
    alert('Error: No delivery assignment selected for editing');
    return;
  }

  // Get the save button and add loading state
  const saveButton = document.querySelector('button[onclick="saveDeliveryAssignment()"]');
  const originalButtonHTML = saveButton.innerHTML;

  // Show loading state
  saveButton.disabled = true;
  saveButton.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Updating...';

  const form = document.getElementById('editDeliveryAssignmentForm');
  const formData = new FormData(form);

  // Prepare the data with correct parameter names and date format conversion
  const scheduledDate = formData.get('scheduled_date');

  // Convert DD.MM.YYYY to YYYY-MM-DD if needed
  let formattedDate = scheduledDate;
  if (scheduledDate && scheduledDate.match(/^\d{2}\.\d{2}\.\d{4}$/)) {
    const [day, month, year] = scheduledDate.split('.');
    formattedDate = `${year}-${month}-${day}`;
  }

  // Handle delivery person ID properly - don't send if empty to avoid validation errors
  const deliveryPersonId = formData.get('delivery_person_id');

  const data = {
    delivery_assignment: {
      scheduled_date: formattedDate,
      status: formData.get('status'),
      quantity: parseFloat(formData.get('quantity')),
      unit: formData.get('unit'),
      final_amount_after_discount: formData.get('final_amount_after_discount') ? parseFloat(formData.get('final_amount_after_discount')) : null,
      special_instructions: formData.get('special_instructions')
    }
  };

  // Only include user_id/delivery_person_id if a delivery person is actually selected
  if (deliveryPersonId && deliveryPersonId !== '') {
    data.delivery_assignment.user_id = deliveryPersonId;
    data.delivery_assignment.delivery_person_id = deliveryPersonId;
  }

  console.log('Sending update data:', data);

  // Get CSRF token
  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') ||
                   document.querySelector('[name="csrf-token"]')?.content;

  fetch(`/assign_deliveries/${currentEditingDeliveryId}.json`, {
    method: 'PATCH',
    headers: {
      'Content-Type': 'application/json',
      'Accept': 'application/json',
      'X-CSRF-Token': csrfToken,
      'X-Requested-With': 'XMLHttpRequest'
    },
    body: JSON.stringify(data)
  })
  .then(response => {
    console.log('Response status:', response.status);
    if (!response.ok) {
      if (response.status === 422) {
        return response.json().then(data => {
          throw new Error(data.message || 'Validation failed');
        });
      }
      throw new Error(`HTTP error! status: ${response.status}`);
    }
    return response.json();
  })
  .then(result => {
    console.log('Update result:', result);

    // Reset button state
    saveButton.disabled = false;
    saveButton.innerHTML = originalButtonHTML;

    if (result.success) {
      // Close the edit modal
      closeEditDeliveryModal();

      // Reload delivery assignments to show updated data
      const modal = document.getElementById('deliveryAssignmentsModal');
      const invoiceId = modal.dataset.invoiceId;
      if (invoiceId) {
        loadDeliveryAssignments(invoiceId);
        // Also recalculate invoice if needed
        if (typeof recalculateInvoice === 'function') {
          recalculateInvoice(invoiceId);
        }
      }

      // Show success message
      if (typeof showNotification === 'function') {
        showNotification(result.message || 'Delivery assignment updated successfully!', 'success');
      } else {
        alert('✅ ' + (result.message || 'Delivery assignment updated successfully!'));
      }
    } else {
      let errorMessage = result.message || 'Failed to update delivery assignment';

      // If there are specific validation errors, show them
      if (result.errors && Array.isArray(result.errors)) {
        errorMessage = 'Validation errors:\n• ' + result.errors.join('\n• ');
      }

      alert('❌ Error: ' + errorMessage);
    }
  })
  .catch(error => {
    console.error('Error updating delivery assignment:', error);

    // Reset button state
    saveButton.disabled = false;
    saveButton.innerHTML = originalButtonHTML;

    alert('❌ Error: Failed to update delivery assignment. Please try again.');
  });
}

