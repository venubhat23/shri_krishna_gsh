<script>
document.addEventListener('DOMContentLoaded', function() {
  const deliveryPersonSelect = document.getElementById('modal-delivery-person-select');
  const customerCheckboxContainer = document.getElementById('customer-checkbox-container');

  // Store original customer checkboxes
  const originalCustomerCheckboxes = Array.from(customerCheckboxContainer.querySelectorAll('.customer-checkbox'));

  // Handle customer filter radio buttons
  const filterRadios = document.querySelectorAll('input[name="customer-filter"]');
  filterRadios.forEach(radio => {
    radio.addEventListener('change', function() {
      const uninvoicedContainer = document.getElementById('uninvoiced-customers');
      const allContainer = document.getElementById('all-customers');
      const selectAllCheckbox = document.getElementById('select-all-customers');

      if (this.value === 'all') {
        // Show all customers
        uninvoicedContainer.style.display = 'none';
        allContainer.style.display = 'block';
        console.log('Switched to show all customers');
      } else {
        // Show only uninvoiced customers
        uninvoicedContainer.style.display = 'block';
        allContainer.style.display = 'none';
        console.log('Switched to show uninvoiced customers only');
      }

      // Reset selections when filter changes
      if (selectAllCheckbox) {
        selectAllCheckbox.checked = false;
        selectAllCheckbox.indeterminate = false;
      }

      // Uncheck all checkboxes
      const allCheckboxes = customerCheckboxContainer.querySelectorAll('.customer-checkbox-input');
      allCheckboxes.forEach(cb => cb.checked = false);

      // Re-setup handlers and update counts
      if (window.reSetupCheckboxHandlers) {
        window.reSetupCheckboxHandlers();
      }
      updateCustomerCount();
      updateSelectedCustomerIds();
    });
  });
  
  // Add search functionality to delivery person dropdown
  function addSearchToDeliveryPerson() {
    const searchInput = document.createElement('input');
    searchInput.type = 'text';
    searchInput.className = 'form-control mb-2';
    searchInput.placeholder = 'Search delivery persons...';
    searchInput.id = 'delivery-person-search';
    
    deliveryPersonSelect.parentNode.insertBefore(searchInput, deliveryPersonSelect);
    
    searchInput.addEventListener('input', function() {
      const searchTerm = this.value.toLowerCase();
      const options = deliveryPersonSelect.options;
      
      for (let i = 0; i < options.length; i++) {
        const option = options[i];
        const text = option.text.toLowerCase();
        option.style.display = text.includes(searchTerm) ? '' : 'none';
      }
    });
  }
  
  // Add search functionality to customer checkboxes
  function addSearchToCustomer() {
    const searchInput = document.createElement('input');
    searchInput.type = 'text';
    searchInput.className = 'form-control mb-2';
    searchInput.placeholder = 'Search customers...';
    searchInput.id = 'customer-search';

    customerCheckboxContainer.parentNode.insertBefore(searchInput, customerCheckboxContainer);

    searchInput.addEventListener('input', function() {
      const searchTerm = this.value.toLowerCase();
      const checkboxes = customerCheckboxContainer.querySelectorAll('.customer-checkbox');

      checkboxes.forEach(checkbox => {
        const label = checkbox.querySelector('label');
        const text = label.textContent.toLowerCase();
        checkbox.style.display = text.includes(searchTerm) ? '' : 'none';
      });

      // Update count after search
      updateCustomerCount();
    });
  }
  
  // Filter customers based on selected delivery person
  function filterCustomersByDeliveryPerson() {
    const selectedDeliveryPersonId = deliveryPersonSelect.value;

    console.log('Filtering by delivery person:', selectedDeliveryPersonId);

    // Get all customer checkboxes from both containers
    const allCustomerCheckboxes = customerCheckboxContainer.querySelectorAll('.customer-checkbox');

    // Show/hide customer checkboxes based on delivery person
    allCustomerCheckboxes.forEach(checkbox => {
      const deliveryPersonId = checkbox.getAttribute('data-delivery-person');

      if (selectedDeliveryPersonId === 'all' || deliveryPersonId === selectedDeliveryPersonId) {
        checkbox.style.display = '';
      } else {
        checkbox.style.display = 'none';
        // Uncheck hidden customers
        const input = checkbox.querySelector('input');
        if (input) input.checked = false;
      }
    });

    // Reset "Select All" checkbox when filter changes
    const selectAllCheckbox = document.getElementById('select-all-customers');
    if (selectAllCheckbox) {
      selectAllCheckbox.checked = false;
      selectAllCheckbox.indeterminate = false;
    }

    // Re-setup checkbox handlers for newly visible checkboxes
    if (window.reSetupCheckboxHandlers) {
      window.reSetupCheckboxHandlers();
    }

    // Update customer count after filtering
    updateCustomerCount();
    updateSelectedCustomerIds();
  }
  
  // Handle delivery person selection change
  deliveryPersonSelect.addEventListener('change', function() {
    filterCustomersByDeliveryPerson();
    
    // Clear customer search when delivery person changes
    const customerSearchInput = document.getElementById('customer-search');
    if (customerSearchInput) {
      customerSearchInput.value = '';
    }
  });
  
  // Handle customer checkbox selection
  function setupCustomerCheckboxHandlers() {
    const selectAllCheckbox = document.getElementById('select-all-customers');
    const hiddenInput = document.getElementById('selected-customer-ids');

    // Handle "Select All" checkbox
    selectAllCheckbox.addEventListener('change', function() {
      console.log('Select All clicked:', this.checked);

      // Determine which container is currently visible
      const uninvoicedContainer = document.getElementById('uninvoiced-customers');
      const allContainer = document.getElementById('all-customers');

      let activeContainer;
      if (uninvoicedContainer && uninvoicedContainer.style.display !== 'none') {
        activeContainer = uninvoicedContainer;
      } else if (allContainer && allContainer.style.display !== 'none') {
        activeContainer = allContainer;
      } else {
        activeContainer = uninvoicedContainer; // default
      }

      // Get all visible customer checkboxes from active container only
      const visibleCustomerCheckboxes = Array.from(activeContainer.querySelectorAll('.customer-checkbox-input'))
        .filter(cb => cb.closest('.customer-checkbox').style.display !== 'none');

      console.log('Found visible checkboxes:', visibleCustomerCheckboxes.length, 'in container:', activeContainer.id);

      // Select or deselect all visible checkboxes
      visibleCustomerCheckboxes.forEach(checkbox => {
        checkbox.checked = this.checked;
      });

      updateSelectedCustomerIds();
      updateCustomerCount();
    });

    // Handle individual customer checkboxes
    function setupIndividualCheckboxHandlers() {
      const customerCheckboxes = customerCheckboxContainer.querySelectorAll('.customer-checkbox-input');

      customerCheckboxes.forEach(checkbox => {
        // Remove any existing event listeners to prevent duplicates
        checkbox.removeEventListener('change', handleIndividualCheckboxChange);
        // Add a flag to prevent multiple listeners
        if (!checkbox.hasEventListener) {
          checkbox.addEventListener('change', handleIndividualCheckboxChange);
          checkbox.hasEventListener = true;
        }
      });
    }

    function handleIndividualCheckboxChange() {
      console.log('🔥 Individual checkbox changed:', this.value, this.checked);
      console.log('🔥 Calling updateCustomerCount and updateSelectedCustomerIds');


      // Determine which container is currently visible
      const uninvoicedContainer = document.getElementById('uninvoiced-customers');
      const allContainer = document.getElementById('all-customers');

      let activeContainer;
      if (uninvoicedContainer && uninvoicedContainer.style.display !== 'none') {
        activeContainer = uninvoicedContainer;
      } else if (allContainer && allContainer.style.display !== 'none') {
        activeContainer = allContainer;
      } else {
        activeContainer = uninvoicedContainer; // default
      }

      // Get all visible checkboxes from active container only
      const visibleCheckboxes = Array.from(activeContainer.querySelectorAll('.customer-checkbox-input'))
        .filter(cb => cb.closest('.customer-checkbox').style.display !== 'none');

      const checkedVisibleCheckboxes = visibleCheckboxes.filter(cb => cb.checked);

      console.log('Visible checkboxes:', visibleCheckboxes.length, 'Checked:', checkedVisibleCheckboxes.length, 'Container:', activeContainer.id);

      // Update "Select All" checkbox state
      if (checkedVisibleCheckboxes.length === 0) {
        // No checkboxes selected
        selectAllCheckbox.checked = false;
        selectAllCheckbox.indeterminate = false;
      } else if (checkedVisibleCheckboxes.length === visibleCheckboxes.length) {
        // All checkboxes selected
        selectAllCheckbox.checked = true;
        selectAllCheckbox.indeterminate = false;
      } else {
        // Some checkboxes selected (indeterminate state)
        selectAllCheckbox.checked = false;
        selectAllCheckbox.indeterminate = true;
      }

      updateSelectedCustomerIds();
      updateCustomerCount();
    }

    // Initial setup
    setupIndividualCheckboxHandlers();

    // Re-setup handlers when delivery person filter changes
    window.reSetupCheckboxHandlers = setupIndividualCheckboxHandlers;
  }

  // Function to update hidden input with selected customer IDs
  function updateSelectedCustomerIds() {
    const hiddenInput = document.getElementById('selected-customer-ids');
    const selectAllCheckbox = document.getElementById('select-all-customers');

    // Determine which container is currently visible
    const uninvoicedContainer = document.getElementById('uninvoiced-customers');
    const allContainer = document.getElementById('all-customers');

    let activeContainer;
    if (uninvoicedContainer && uninvoicedContainer.style.display !== 'none') {
      activeContainer = uninvoicedContainer;
    } else if (allContainer && allContainer.style.display !== 'none') {
      activeContainer = allContainer;
    } else {
      activeContainer = uninvoicedContainer; // default
    }

    // Get all visible and checked customer checkboxes from active container only
    const visibleCheckedCheckboxes = Array.from(activeContainer.querySelectorAll('.customer-checkbox-input'))
      .filter(cb => cb.closest('.customer-checkbox').style.display !== 'none' && cb.checked);

    // Get all visible checkboxes from active container only
    const allVisibleCheckboxes = Array.from(activeContainer.querySelectorAll('.customer-checkbox-input'))
      .filter(cb => cb.closest('.customer-checkbox').style.display !== 'none');

    console.log('Updating hidden input. Checked:', visibleCheckedCheckboxes.length, 'Total visible:', allVisibleCheckboxes.length, 'Container:', activeContainer.id);

    // Clear existing hidden inputs
    const existingHiddenInputs = document.querySelectorAll('input[name="customer_ids[]"][type="hidden"]');
    existingHiddenInputs.forEach(input => input.remove());

    if (selectAllCheckbox.checked && visibleCheckedCheckboxes.length === allVisibleCheckboxes.length) {
      // All customers selected
      const allInput = document.createElement('input');
      allInput.type = 'hidden';
      allInput.name = 'customer_ids[]';
      allInput.value = 'all';
      hiddenInput.parentNode.appendChild(allInput);
      console.log('Set hidden input to: all');
    } else {
      // Specific customers selected - create individual hidden inputs
      const selectedIds = visibleCheckedCheckboxes.map(cb => cb.value);
      selectedIds.forEach(id => {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'customer_ids[]';
        input.value = id;
        hiddenInput.parentNode.appendChild(input);
      });
      console.log('Set hidden inputs to:', selectedIds);
    }
  }

  // Function to update customer count display
  let updateCustomerCountTimeout;
  function updateCustomerCount() {
    // Debounce the function to prevent excessive calls
    if (updateCustomerCountTimeout) {
      clearTimeout(updateCustomerCountTimeout);
    }

    updateCustomerCountTimeout = setTimeout(() => {
