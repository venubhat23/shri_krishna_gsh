  // Enhanced phone validation and send functionality
  function initializeWhatsAppModalEvents() {
    const phoneInput = document.getElementById('whatsAppCustomerPhone');
    const sendBtn = document.getElementById('sendWhatsAppBtn');

    if (phoneInput && sendBtn) {
      // Phone validation
      phoneInput.addEventListener('input', function() {
        const phone = this.value.trim();
        const isValid = phone.length >= 10 && /^\+?[\d\s\-\(\)]+$/.test(phone);
        sendBtn.disabled = !isValid;

        if (isValid) {
          this.classList.remove('is-invalid');
          this.classList.add('is-valid');
        } else if (phone.length > 0) {
          this.classList.remove('is-valid');
          this.classList.add('is-invalid');
        } else {
          this.classList.remove('is-valid', 'is-invalid');
        }
      });

      // Enhanced send WhatsApp functionality
      sendBtn.addEventListener('click', function() {
        if (!currentInvoiceData) {
          alert('Please select an invoice first');
          return;
        }

        const phoneNumber = phoneInput.value.trim();
        if (!phoneNumber) {
          alert('Please enter a phone number');
          return;
        }

        console.log('📱 Sending WhatsApp for invoice:', currentInvoiceData.id);

        // Show loading state with better UX
        this.disabled = true;
        this.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Generating secure link...';

        // Make AJAX request to share_whatsapp endpoint
        fetch(`/invoices/${currentInvoiceData.id}/share_whatsapp`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('[name="csrf-token"]').getAttribute('content')
          },
          body: JSON.stringify({
            phone_number: phoneNumber
          })
        })
        .then(response => response.json())
