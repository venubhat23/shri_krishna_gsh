// Automatic calculation for add form
function setupAddFormCalculations() {
  const productSelect = document.getElementById('addProduct');
  const quantityInput = document.getElementById('addQuantity');
  const discountInput = document.getElementById('addDiscountAmount');

  // Add event listeners for automatic calculation
  productSelect.addEventListener('change', calculateAddAmounts);
  quantityInput.addEventListener('input', calculateAddAmounts);
  discountInput.addEventListener('input', calculateAddAmounts);
}

function calculateAddAmounts() {
  const productSelect = document.getElementById('addProduct');
  const quantity = parseFloat(document.getElementById('addQuantity').value) || 0;
  const discount = parseFloat(document.getElementById('addDiscountAmount').value) || 0;

  // Get unit price from selected product
  const selectedOption = productSelect.options[productSelect.selectedIndex];
  const unitPrice = parseFloat(selectedOption.dataset.price) || 0;

  // Calculate base amount
  const baseAmount = unitPrice * quantity;

  // Calculate final amount after discount
  const finalAmount = Math.max(0, baseAmount - discount);

  // Update the readonly fields
  document.getElementById('addUnitPrice').value = unitPrice.toFixed(2);
  document.getElementById('addBaseAmount').value = baseAmount.toFixed(2);
  document.getElementById('addFinalAmount').value = finalAmount.toFixed(2);
}

function saveNewDeliveryAssignment() {
  const saveButton = document.getElementById('saveAddDeliveryBtn');
  const originalButtonHTML = saveButton.innerHTML;

  // Show loading state
  saveButton.disabled = true;
  saveButton.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Saving...';

  // Get form data
  const formData = new FormData(document.getElementById('addDeliveryAssignmentForm'));

  // Get invoice ID from the delivery assignments modal
  const deliveryModal = document.getElementById('deliveryAssignmentsModal');
  const invoiceId = deliveryModal.dataset.invoiceId;

  if (!invoiceId) {
    alert('Error: Invoice ID not found');
    saveButton.disabled = false;
    saveButton.innerHTML = originalButtonHTML;
    return;
  }

  // Prepare data for submission
  const data = {
    delivery_assignment: {
      customer_id: getCurrentCustomerId(), // Will get from invoice
      invoice_id: invoiceId,
      product_id: parseInt(formData.get('product_id')),
      delivery_person_id: parseInt(formData.get('delivery_person_id')),
      scheduled_date: formData.get('scheduled_date'),
      status: formData.get('status'),
      quantity: parseFloat(formData.get('quantity')),
      unit: formData.get('unit'),
      discount_amount: parseFloat(formData.get('discount_amount')) || 0,
      final_amount_after_discount: parseFloat(formData.get('final_amount_after_discount')),
      special_instructions: formData.get('special_instructions') || '',
      invoice_generated: true
    }
  };

  // Submit to backend
  fetch('/assign_deliveries', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Accept': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content'),
      'X-Requested-With': 'XMLHttpRequest'
    },
    body: JSON.stringify(data)
  })
  .then(response => response.json())
  .then(result => {
    // Reset button state
    saveButton.disabled = false;
    saveButton.innerHTML = originalButtonHTML;

    if (result.success) {
      // Close the add modal
      closeAddDeliveryModal();

      // Reload delivery assignments to show new data
      loadDeliveryAssignments(invoiceId);

      // Recalculate invoice
      if (typeof recalculateInvoice === 'function') {
        recalculateInvoice(invoiceId);
      }

      // Show success message
      if (typeof showNotification === 'function') {
        showNotification(result.message || 'Delivery assignment added successfully!', 'success');
      } else {
        alert('✅ ' + (result.message || 'Delivery assignment added successfully!'));
      }
    } else {
      let errorMessage = result.message || 'Failed to add delivery assignment';

      // If there are specific validation errors, show them
      if (result.errors && Array.isArray(result.errors)) {
        errorMessage = 'Validation errors:\n• ' + result.errors.join('\n• ');
      }

      alert('❌ Error: ' + errorMessage);
    }
  })
  .catch(error => {
    console.error('Error adding delivery assignment:', error);

    // Reset button state
    saveButton.disabled = false;
    saveButton.innerHTML = originalButtonHTML;

    alert('❌ Error: Failed to add delivery assignment. Please try again.');
  });
}

function getCurrentCustomerId() {
  // Get customer ID from the delivery assignments modal info
  const customerInfo = document.getElementById('modalCustomerName');
  if (customerInfo && customerInfo.dataset.customerId) {
    return parseInt(customerInfo.dataset.customerId);
  }

  // Fallback: try to get from invoice data
  const deliveryModal = document.getElementById('deliveryAssignmentsModal');
  const invoiceId = deliveryModal.dataset.invoiceId;

  // This might need to be fetched from the server if not available
  // For now, we'll handle this in the backend by looking up the invoice
  return null;
}

// Initialize calculations when document loads
document.addEventListener('DOMContentLoaded', function() {
  setupAddFormCalculations();
});
</script>

