  // Load customers based on selected month and year
  function loadCustomersForMonth() {
    const monthSelect = document.getElementById('modal-month-select');
    const yearSelect = document.getElementById('modal-year-select');

    if (!monthSelect || !yearSelect) {
      console.log('Month or year select not found');
      return;
    }

    const selectedMonth = monthSelect.value;
    const selectedYear = yearSelect.value;

    console.log('🔄 Loading customers for:', selectedMonth, selectedYear);

    // Load customers for both containers
    loadCustomersForContainer('uninvoiced-customers', selectedMonth, selectedYear, false);
    loadCustomersForContainer('all-customers', selectedMonth, selectedYear, true);
  }

  // Load customers for a specific container
  function loadCustomersForContainer(containerId, month, year, showAll = false) {
    const container = document.getElementById(containerId);
    if (!container) return;

    // Show loading
    container.innerHTML = '<div class="text-center text-muted p-3"><i class="fas fa-spinner fa-spin me-2"></i>Loading customers...</div>';

    // Make AJAX request to load customers
    const url = '/invoices/customers_for_month';
    const params = new URLSearchParams({
      month: month,
      year: year,
      show_all: showAll
    });

    console.log(`🌐 Fetching customers: ${url}?${params}`);

    fetch(`${url}?${params}`, {
      method: 'GET',
      headers: {
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      }
    })
    .then(response => {
      console.log('📡 Response received:', response.status, response.statusText);
      if (!response.ok) {
        throw new Error(`HTTP ${response.status}: ${response.statusText}`);
      }
      return response.json();
    })
    .then(data => {
      console.log('📊 Data received:', data);
      if (data.success) {
        console.log(`✅ Successfully loaded ${data.count} customers`);
        container.innerHTML = data.html;
        // Re-setup event handlers after loading new content
        setupCustomerCheckboxHandlers();
        updateCustomerCount();
      } else {
        console.error('❌ Server returned error:', data.error);
        container.innerHTML = '<div class="text-center text-danger p-3">Error loading customers</div>';
      }
    })
    .catch(error => {
      console.error('❌ Network/parsing error:', error);
      container.innerHTML = '<div class="text-center text-danger p-3">Error loading customers</div>';
    });
  }

  // Initialize search functionality when modal opens
