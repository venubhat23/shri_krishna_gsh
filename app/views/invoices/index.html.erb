// Delivery Assignments Modal functionality
function openDeliveryAssignmentsModal(button) {
  const invoiceId = button.getAttribute('data-invoice-id');
  const invoiceNumber = button.getAttribute('data-invoice-number');
  const customerName = button.getAttribute('data-customer-name');
  const customerId = button.getAttribute('data-customer-id');

  // Set modal title and info
  document.getElementById('modalInvoiceNumber').textContent = invoiceNumber;
  const customerElement = document.getElementById('modalCustomerName');
  customerElement.textContent = customerName;
  customerElement.dataset.customerId = customerId; // Store customer ID for add modal

  // Show modal
  const modal = document.getElementById('deliveryAssignmentsModal');
  modal.dataset.invoiceId = invoiceId; // Store invoice ID for later use
  modal.style.display = 'flex';

  // Load delivery assignments
  loadDeliveryAssignments(invoiceId);
}

function closeDeliveryAssignmentsModal() {
  const modal = document.getElementById('deliveryAssignmentsModal');
  modal.style.display = 'none';

  // Clear table
  document.getElementById('deliveryAssignmentsTableBody').innerHTML = '';
}

function loadDeliveryAssignments(invoiceId) {
  // Show loading state
  const tableBody = document.getElementById('deliveryAssignmentsTableBody');
  tableBody.innerHTML = '<tr><td colspan="7" class="text-center"><i class="fas fa-spinner fa-spin me-2"></i>Loading delivery assignments...</td></tr>';

  // Fetch delivery assignments from server
  fetch(`/invoices/${invoiceId}/delivery_assignments`)
    .then(response => response.json())
    .then(data => {
      displayDeliveryAssignments(data.delivery_assignments);
      updateDeliverySummary(data.delivery_assignments);
    })
    .catch(error => {
      console.error('Error loading delivery assignments:', error);
      tableBody.innerHTML = '<tr><td colspan="7" class="text-center text-danger"><i class="fas fa-exclamation-triangle me-2"></i>Error loading delivery assignments</td></tr>';
    });
}

function displayDeliveryAssignments(deliveryAssignments) {
  const tableBody = document.getElementById('deliveryAssignmentsTableBody');

  if (deliveryAssignments.length === 0) {
    tableBody.innerHTML = '<tr><td colspan="7" class="text-center text-muted"><i class="fas fa-info-circle me-2"></i>No delivery assignments found for this invoice</td></tr>';
    return;
  }

  const rows = deliveryAssignments.map(delivery => {
    const statusBadge = getStatusBadge(delivery.status);
    const scheduledDate = new Date(delivery.scheduled_date).toLocaleDateString();
    const amount = delivery.final_amount_after_discount ? `₹${parseFloat(delivery.final_amount_after_discount).toFixed(2)}` : '-';
    const deliveryPerson = delivery.delivery_person_name || 'Not assigned';

    return `
      <tr data-delivery-id="${delivery.id}">
        <td>${scheduledDate}</td>
        <td>${delivery.product_name}</td>
        <td>${delivery.quantity} ${delivery.unit}</td>
        <td>${deliveryPerson}</td>
        <td>${statusBadge}</td>
        <td>${amount}</td>
        <td>
          <div class="btn-group" role="group">
            <button type="button"
                    class="btn btn-sm btn-outline-primary"
                    onclick="editDeliveryAssignment(${delivery.id})"
                    title="Edit Delivery Assignment">
              <i class="fas fa-edit"></i>
            </button>
            <button type="button"
                    class="btn btn-sm btn-outline-danger"
                    onclick="deleteDeliveryAssignment(${delivery.id})"
                    title="Delete Delivery Assignment">
              <i class="fas fa-trash"></i>
            </button>
          </div>
        </td>
      </tr>
    `;
  }).join('');

  tableBody.innerHTML = rows;
}

function getStatusBadge(status) {
  const statusMap = {
    'pending': '<span class="badge bg-warning"><i class="fas fa-clock me-1"></i>Pending</span>',
    'completed': '<span class="badge bg-success"><i class="fas fa-check me-1"></i>Completed</span>',
    'cancelled': '<span class="badge bg-danger"><i class="fas fa-times me-1"></i>Cancelled</span>',
    'in_progress': '<span class="badge bg-info"><i class="fas fa-truck me-1"></i>In Progress</span>'
  };

  return statusMap[status] || `<span class="badge bg-secondary">${status}</span>`;
}

function updateDeliverySummary(deliveryAssignments) {
  const totalDeliveries = deliveryAssignments.length;
  const completedDeliveries = deliveryAssignments.filter(d => d.status === 'completed').length;
  const pendingDeliveries = deliveryAssignments.filter(d => d.status === 'pending' || d.status === 'in_progress').length;

  document.getElementById('totalDeliveries').textContent = totalDeliveries;
  document.getElementById('completedDeliveries').textContent = completedDeliveries;
  document.getElementById('pendingDeliveries').textContent = pendingDeliveries;
}

// Edit delivery assignment function
function editDeliveryAssignment(deliveryId) {
  if (!deliveryId) {
    console.error('No delivery ID provided');
    alert('Error: No delivery assignment selected');
    return;
  }

  // Get the button that was clicked to show loader
  const button = event.target.closest('button');
  const originalHTML = button.innerHTML;

  // Show loading state on button
  button.disabled = true;
  button.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

  try {
    showEditDeliveryModal(deliveryId, button, originalHTML);
  } catch (error) {
    console.error('Error opening edit modal:', error);
    alert('Error opening edit modal: ' + error.message);

    // Reset button state on error
    button.disabled = false;
    button.innerHTML = originalHTML;
  }
}

// Delete delivery assignment function
function deleteDeliveryAssignment(deliveryId) {
  if (!confirm('Are you sure you want to delete this delivery assignment? This action cannot be undone.')) {
    return;
  }

  // Find the delete button and add loader
  const button = event.target.closest('button');
  const originalHTML = button.innerHTML;
  button.disabled = true;
  button.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

  fetch(`/assign_deliveries/${deliveryId}`, {
    method: 'DELETE',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
    }
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      // Remove the row from the table
      const row = document.querySelector(`tr[data-delivery-id="${deliveryId}"]`);
      if (row) {
        row.remove();
      }

      // Reload delivery assignments to update summary
      const modal = document.getElementById('deliveryAssignmentsModal');
      const invoiceId = modal.dataset.invoiceId;
      if (invoiceId) {
        loadDeliveryAssignments(invoiceId);
        recalculateInvoice(invoiceId);
      }

      alert(data.message || 'Delivery assignment deleted successfully!');
    } else {
      alert('Error: ' + (data.message || 'Failed to delete delivery assignment'));
    }
  })
  .catch(error => {
    console.error('Error deleting delivery assignment:', error);
    alert('Error: Failed to delete delivery assignment');
  })
  .finally(() => {
    // Restore button state
    button.disabled = false;
    button.innerHTML = originalHTML;
  });
}

// Function to recalculate invoice after changes
function recalculateInvoice(invoiceId) {
  fetch(`/invoices/${invoiceId}/recalculate`, {
    method: 'PATCH',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
    }
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      console.log('Invoice recalculated successfully:', data.total_amount);
      // Optionally show a notification
      showNotification('Invoice recalculated successfully!', 'success');
    } else {
      console.error('Failed to recalculate invoice:', data.error);
    }
  })
  .catch(error => {
    console.error('Error recalculating invoice:', error);
  });
}

// Helper function to show notifications
function showNotification(message, type = 'info') {
  // Create a simple notification element
  const notification = document.createElement('div');
  notification.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
  notification.style.cssText = 'top: 20px; right: 20px; z-index: 99999; max-width: 400px;';
  notification.innerHTML = `
    ${message}
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  `;

  document.body.appendChild(notification);

  // Auto-remove after 3 seconds
  setTimeout(() => {
    if (notification.parentNode) {
      notification.remove();
    }
  }, 3000);
}

// Note: currentEditingDeliveryId is declared earlier in the script

// Function to show edit delivery modal
function showEditDeliveryModal(deliveryId, button, originalHTML) {
  if (typeof currentEditingDeliveryId === 'undefined') {
    window.currentEditingDeliveryId = null;
  }
  currentEditingDeliveryId = deliveryId;

  // Load delivery assignment data
  fetch(`/assign_deliveries/${deliveryId}`, {
    method: 'GET',
    headers: {
      'Content-Type': 'application/json',
      'Accept': 'application/json'
    }
  })
  .then(response => response.json())
  .then(data => {
    // Reset button state
    if (button && originalHTML) {
      button.disabled = false;
      button.innerHTML = originalHTML;
    }

    if (data.success !== false) {
      // Populate form fields
      populateEditForm(data);
      // Load delivery people options
      loadDeliveryPeople();
      // Show modal
      const modal = document.getElementById('editDeliveryAssignmentModal');
      if (modal) {
        modal.style.display = 'flex';
      } else {
        console.error('Edit modal not found');
        alert('Error: Edit modal not found');
      }
    } else {
      alert('Error: Failed to load delivery assignment data');
    }
  })
  .catch(error => {
    console.error('Error loading delivery assignment:', error);
    alert('Error: Failed to load delivery assignment data');

    // Reset button state on error
    if (button && originalHTML) {
      button.disabled = false;
      button.innerHTML = originalHTML;
    }
  });
}

