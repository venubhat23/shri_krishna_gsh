    const loader = document.getElementById('invoiceGenerationLoader');
    if (loader) {
      loader.style.display = 'none';
      document.body.style.overflow = '';
    }
  }

  function simulateInvoiceGeneration() {
    const steps = [
      { id: 'step-1', message: '🌱 <%= AdminSetting.current.business_name %> - Validating customer records and permissions...', percent: 25 },
      { id: 'step-2', message: '📄 Generating premium invoices with <%= AdminSetting.current.business_name %> branding...', percent: 50 },
      { id: 'step-3', message: '📱 Sending personalized WhatsApp notifications to valued customers...', percent: 75 },
      { id: 'step-4', message: '✨ Completing invoice generation for <%= AdminSetting.current.business_name %> success!', percent: 100 }
    ];

    // Get modern loader elements
    const progressRings = document.querySelectorAll('.ring-progress');
    const progressNumber = document.querySelector('.percentage-number');
    const progressMessage = document.getElementById('progress-message');

    steps.forEach((step, index) => {
      setTimeout(() => {
        // Update all progress rings with different animations
        progressRings.forEach((ring, ringIndex) => {
          const radius = ring.getAttribute('r');
          const circumference = 2 * Math.PI * radius;
          const offset = circumference - (step.percent / 100) * circumference;

          ring.style.strokeDasharray = circumference;
          ring.style.strokeDashoffset = offset;
        });

        // Update percentage with smooth counting animation
        if (progressNumber) {
          const currentPercent = parseInt(progressNumber.textContent) || 0;
          animateCounter(progressNumber, currentPercent, step.percent, 800);
        }

        // Update message with typewriter effect
        if (progressMessage) {
          typewriterEffect(progressMessage, step.message);
        }

        // Update step states with enhanced animations
        const allSteps = document.querySelectorAll('.modern-step');

        // Mark previous steps as completed
        allSteps.forEach((stepEl, i) => {
          if (i < index) {
            stepEl.classList.remove('active');
            stepEl.classList.add('completed');
          } else if (i === index) {
            stepEl.classList.add('active');
            stepEl.classList.remove('completed');
          } else {
            stepEl.classList.remove('active', 'completed');
          }
        });

      }, (index + 1) * 1200); // Slower, more impressive timing
    });
  }

  // Enhanced helper functions for modern loader
  function animateCounter(element, start, end, duration) {
    const startTime = Date.now();
    const animate = () => {
      const elapsed = Date.now() - startTime;
      const progress = Math.min(elapsed / duration, 1);

      // Easing function for smooth animation
      const easeOutQuart = 1 - Math.pow(1 - progress, 4);
      const current = Math.round(start + (end - start) * easeOutQuart);

      element.textContent = current;

      if (progress < 1) {
        requestAnimationFrame(animate);
      }
    };
    requestAnimationFrame(animate);
  }

  function typewriterEffect(element, text) {
    element.textContent = '';
    let i = 0;
    const speed = 50; // milliseconds per character

    const type = () => {
      if (i < text.length) {
        element.textContent += text.charAt(i);
        i++;
        setTimeout(type, speed);
      }
    };

    type();
  }

  function showSuccessMessage() {
    const successModal = document.getElementById('invoiceSuccessModal');
    const successStats = document.getElementById('success-stats');
    const customerCount = document.getElementById('customer-count-text').textContent;

    if (successModal) {
      // Update stats
      if (successStats) {
        successStats.innerHTML = `
          <div class="d-flex justify-content-between align-items-center">
            <span><i class="fas fa-file-invoice me-2"></i>Invoices Generated:</span>
            <strong>${customerCount}</strong>
          </div>
          <div class="d-flex justify-content-between align-items-center mt-2">
            <span><i class="fab fa-whatsapp me-2"></i>WhatsApp Sent:</span>
            <strong>${customerCount}</strong>
          </div>
        `;
      }

      successModal.style.display = 'flex';
      document.body.style.overflow = 'hidden';

      // Auto close after 4 seconds and refresh page
      setTimeout(() => {
        closeSuccessModal();
      }, 4000);
    }
  }

  window.closeSuccessModal = function() {
    const successModal = document.getElementById('invoiceSuccessModal');
    if (successModal) {
      successModal.style.display = 'none';
      document.body.style.overflow = '';

      // Refresh the entire invoice page to show updated data
      setTimeout(() => {
        window.location.reload();
      }, 500); // Small delay for smooth transition
    }
  };
});
</script>

