function exportRevenueData() {
  // Create CSV export of the revenue breakdown data
  const table = document.querySelector('#revenueBreakdownContent table');
  if (!table) return;

  let csv = [];
  const rows = table.querySelectorAll('tr');

  for (let i = 0; i < rows.length; i++) {
    const row = [], cols = rows[i].querySelectorAll('td, th');

    for (let j = 0; j < cols.length - 1; j++) { // Exclude actions column
      let cellText = cols[j].innerText.replace(/"/g, '""');
      row.push('"' + cellText + '"');
    }

    csv.push(row.join(','));
  }

  const csvFile = new Blob([csv.join('\n')], { type: 'text/csv' });
  const downloadLink = document.createElement('a');
  downloadLink.download = 'revenue_breakdown_<%= @month_name.gsub(" ", "_") %>.csv';
  downloadLink.href = window.URL.createObjectURL(csvFile);
  downloadLink.style.display = 'none';
  document.body.appendChild(downloadLink);
  downloadLink.click();
  document.body.removeChild(downloadLink);

  showSimpleToast('✅ Revenue breakdown exported successfully!', 'success');
}

