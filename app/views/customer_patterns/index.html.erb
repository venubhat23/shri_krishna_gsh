window.openBulkEditModal = function(customerId, customerName, scheduledQuantity, scheduledProduct, month, year) {
  console.log('🎯 Opening bulk edit modal for:', customerName);

  const modal = document.getElementById('bulkEditModal');
  if (!modal) {
    console.error('❌ Bulk edit modal not found!');
    alert('Error: Modal not found');
