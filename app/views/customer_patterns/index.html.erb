    console.log('⚠️ Missing delivery_assignment params, reconstructing...');

    // Clear the form data and rebuild with correct structure
    const newFormData = new FormData();

    // Add delivery_assignment parameters
    const quantity = form.querySelector('[name*="quantity"]')?.value || form.querySelector('#delivery_assignment_quantity')?.value;
    const unit = form.querySelector('[name*="unit"]')?.value || form.querySelector('#delivery_assignment_unit')?.value;
    const scheduledDate = form.querySelector('[name*="scheduled_date"]')?.value || form.querySelector('#delivery_assignment_scheduled_date')?.value;
    const status = form.querySelector('[name*="status"]')?.value || form.querySelector('#delivery_assignment_status')?.value;
    const discountAmount = form.querySelector('[name*="discount_amount"]')?.value || form.querySelector('#delivery_assignment_discount_amount')?.value;

    console.log('📋 Form field values:', {
      quantity, unit, scheduledDate, status, discountAmount
    });

    if (quantity) newFormData.append('delivery_assignment[quantity]', quantity);
    if (unit) newFormData.append('delivery_assignment[unit]', unit);
    if (scheduledDate) newFormData.append('delivery_assignment[scheduled_date]', scheduledDate);
    if (status) newFormData.append('delivery_assignment[status]', status);
    if (discountAmount) newFormData.append('delivery_assignment[discount_amount]', discountAmount);

    // Add Rails-specific parameters
    newFormData.append('_method', 'patch');
    newFormData.append('authenticity_token', csrfToken);

    // Replace the original formData
    formData = newFormData;

    console.log('✅ Rebuilt FormData with delivery_assignment params');
    for (let [key, value] of formData.entries()) {
      console.log(`  ${key}: ${value}`);
    }
  }

  console.log('📤 Making API request:', {
    url: form.action,
    method: 'PATCH',
    formData: Object.fromEntries(formData.entries())
  });

  fetch(form.action, {
    method: 'PATCH',
    body: formData,
    headers: {
      'Accept': 'application/json',
      'X-CSRF-Token': csrfToken
    }
  })
  .then(response => {
    console.log('📥 API Response received:', {
      status: response.status,
      statusText: response.statusText,
      ok: response.ok
    });

    if (!response.ok) {
      throw new Error(`HTTP error! status: ${response.status} - ${response.statusText}`);
    }
    return response.json();
  })
  .then(data => {
    console.log('✅ Success response:', data);
    clearInterval(progressInterval);
    updateProgress(100);

    if (data.success) {
      // Show completion animation
      setTimeout(() => {
        submitBtn.innerHTML = `
          <div class="d-flex align-items-center justify-content-center">
            <i class="fas fa-check-circle text-white me-2"></i>
            <span>Updated Successfully!</span>
          </div>
        `;

        // Show success toast
        if (window.showSimpleToast) {
          window.showSimpleToast(data.message || 'Assignment updated successfully! ✅', 'success');
        }

        // Close the edit modal immediately and refresh main modal
        setTimeout(() => {
          // Close the edit modal using Bootstrap modal method
          const editModal = bootstrap.Modal.getInstance(document.getElementById('editModal'));
          if (editModal) {
            editModal.hide();
          } else {
            // Fallback method if Bootstrap modal instance not found
            const editModalEl = document.getElementById('editModal');
            if (editModalEl) {
              editModalEl.style.display = 'none';
              document.body.classList.remove('modal-open');
              const backdrop = document.querySelector('.modal-backdrop');
              if (backdrop) backdrop.remove();
            }
          }

          // Update the specific row in delivery modal without reloading
          console.log('🔄 Updating specific assignment row in delivery modal...');

          // Find and update the specific assignment row if it exists
          const assignmentId = submitBtn.dataset.assignmentId;
          if (assignmentId && data.assignment) {
            const updatedAssignment = data.assignment;

            // Find the row with this assignment
            const deliveryModal = document.getElementById('deliveryModal');
            if (deliveryModal) {
              // Look for buttons with this assignment ID in their onclick
              const assignmentButtons = deliveryModal.querySelectorAll(`button[onclick*="${assignmentId}"]`);

              if (assignmentButtons.length > 0) {
                const assignmentRow = assignmentButtons[0].closest('tr');
                if (assignmentRow) {
                  console.log('✅ Found assignment row, updating quantity and unit...');

                  // Update quantity column (column 4)
                  const quantityCell = assignmentRow.querySelector('td:nth-child(4)');
                  if (quantityCell && updatedAssignment.quantity && updatedAssignment.unit) {
                    quantityCell.innerHTML = `
                      <span class="badge bg-light text-dark border">
                        <strong>${updatedAssignment.quantity}</strong> ${updatedAssignment.unit}
                      </span>
                    `;
                  }

                  // Update amount column if final_amount is provided (column 7)
                  const amountCell = assignmentRow.querySelector('td:nth-child(7)');
                  if (amountCell && updatedAssignment.final_amount !== undefined) {
                    amountCell.innerHTML = `
                      <div class="text-success fw-bold">
                        ₹${parseFloat(updatedAssignment.final_amount).toFixed(2)}
                      </div>
                    `;
                  }

                  console.log('✅ Assignment row updated successfully');
                } else {
                  console.log('⚠️ Could not find assignment row');
                }
              } else {
                console.log('⚠️ Could not find assignment buttons');
              }
            } else {
              console.log('⚠️ Delivery modal not found');
            }
          }

          // Keep the delivery modal open - DO NOT call reloadCurrentModal()
          console.log('✅ Keeping delivery modal open without reload');
        }, 800); // Reduced from 1500ms to 800ms for faster UX

      }, 300);
    } else {
      throw new Error(data.message || 'Update failed');
    }
  })
  .catch(error => {
    console.error('❌ Error updating assignment:', error);
    clearInterval(progressInterval);

    // Show error state
    submitBtn.innerHTML = `
      <div class="d-flex align-items-center justify-content-center">
        <i class="fas fa-exclamation-triangle text-warning me-2"></i>
        <span>Update Failed</span>
      </div>
    `;

    if (window.showSimpleToast) {
      window.showSimpleToast('Error updating assignment: ' + error.message, 'error');
    }

    // Re-enable form after showing error
    setTimeout(() => {
      submitBtn.innerHTML = originalText;
      inputs.forEach(input => input.disabled = false);
    }, 2000);
  });
}

