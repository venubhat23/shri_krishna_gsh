  });

})();

// Function to update stats based on visible table rows
function updateStatsFromVisibleRows() {
  const visibleRows = document.querySelectorAll('.customer-pattern-row:not(.d-none)');
  let totalCustomers = 0;
  let regularCount = 0;
  let irregularCount = 0;
  let totalAmount = 0;

  visibleRows.forEach(row => {
    totalCustomers++;

    // Get pattern type from the pattern column (column 8)
    const patternCell = row.querySelector('td:nth-child(8)');
    if (patternCell) {
      const patternBadge = patternCell.querySelector('.badge-modern');
      if (patternBadge) {
        const patternText = patternBadge.textContent.toLowerCase();
        if (patternText.includes('regular') || patternText.includes('every day')) {
          regularCount++;
        } else {
          irregularCount++;
        }
      }
    }

    // Get amount from the amount column (column 7 - contains ₹ symbol)
    const amountCell = row.querySelector('td:nth-child(7)');
    if (amountCell) {
      const amountText = amountCell.textContent.replace(/[₹,]/g, '').trim();
      const amount = parseFloat(amountText) || 0;
      totalAmount += amount;
    }
  });

  // Update the stat cards
  const totalCustomersStat = document.getElementById('total-customers-stat');
  const regularCustomersStat = document.getElementById('regular-customers-stat');
  const irregularCustomersStat = document.getElementById('irregular-customers-stat');
  const totalAmountStat = document.getElementById('total-amount-stat');

  if (totalCustomersStat) totalCustomersStat.textContent = totalCustomers;
  if (regularCustomersStat) regularCustomersStat.textContent = regularCount;
  if (irregularCustomersStat) irregularCustomersStat.textContent = irregularCount;
  if (totalAmountStat) {
    totalAmountStat.textContent = '₹' + totalAmount.toLocaleString('en-IN', { maximumFractionDigits: 0 });
  }
}

