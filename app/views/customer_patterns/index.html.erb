<script>
// CRITICAL FUNCTIONS - MUST BE FIRST TO LOAD
// These functions are called from onclick handlers and must be available immediately

window.completeAll = function(customerId, month, year) {
  console.log('🎯 completeAll called:', customerId, month, year);
  if (!confirm('Mark ALL pending assignments for this customer as completed?')) return;

  const button = event.target.closest('button');
  if (button) {
    const originalHTML = button.innerHTML;
    button.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Processing...';
    button.disabled = true;

    fetch('/customer-patterns/complete_all', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
      },
      body: JSON.stringify({
        customer_id: customerId,
        month: month,
        year: year
      })
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        alert('✅ All assignments completed successfully!');
        setTimeout(() => location.reload(), 1000);
      } else {
        alert('❌ Error completing assignments: ' + (data.message || 'Unknown error'));
      }
    })
    .catch(error => {
      console.error('Error:', error);
      alert('❌ Error completing assignments');
    })
    .finally(() => {
      button.innerHTML = originalHTML;
      button.disabled = false;
    });
  }
};

window.completeTillToday = function(customerId, month, year) {
  console.log('🎯 completeTillToday called:', customerId, month, year);
  if (!confirm('Mark all pending assignments till today as completed?')) return;

  const button = event.target.closest('button');
  if (button) {
    const originalHTML = button.innerHTML;
