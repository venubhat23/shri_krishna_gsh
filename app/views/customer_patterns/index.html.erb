};

window.bulkDeleteAssignments = function() {
  console.log('🗑️ Global bulk delete function called');

  // Prevent any default navigation
  if (event) {
    event.preventDefault();
    event.stopPropagation();
  }

  const checkedBoxes = document.querySelectorAll('.assignment-checkbox:checked');

  if (checkedBoxes.length === 0) {
    console.log('No assignments selected for deletion');
    return;
  }

  const assignmentIds = Array.from(checkedBoxes).map(cb => cb.getAttribute('data-assignment-id'));
  const button = document.getElementById('bulkDeleteBtn');

  if (!button) {
    console.error('Delete button not found!');
    return;
  }

  // Show attractive loading (same as Complete All This Month)
  const originalText = button.innerHTML;
  button.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Processing...';
  button.disabled = true;

  // Add visual feedback - fade out selected rows
  checkedBoxes.forEach(checkbox => {
    const row = checkbox.closest('tr');
    if (row) {
      row.style.transition = 'all 0.3s ease';
      row.style.opacity = '0.5';
      row.style.transform = 'scale(0.98)';
      row.style.pointerEvents = 'none';
    }
  });

  fetch('/customer-patterns/bulk_delete_assignments', {
    method: 'DELETE',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
    },
    body: JSON.stringify({ assignment_ids: assignmentIds })
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      setTimeout(() => {
        // Check if we're in a modal
        if (document.querySelector('#deliveryModal.show')) {
          // Just remove the selected rows from the table
          checkedBoxes.forEach(checkbox => {
            const row = checkbox.closest('tr');
            if (row) {
              row.remove();
            }
          });

          // Update assignment count in header
          const header = document.querySelector('#deliveryModal h5');
          if (header) {
            const currentText = header.textContent;
            const match = currentText.match(/\((\d+) assignments\)/);
            if (match) {
              const newCount = parseInt(match[1]) - checkedBoxes.length;
              header.textContent = currentText.replace(/\(\d+ assignments\)/, `(${newCount} assignments)`);
            }
          }

          // Update delete button state
          if (typeof window.updateDeleteButton === 'function') {
            window.updateDeleteButton();
          }
        } else {
          location.reload();
        }
      }, 500);
    } else {
      console.error('Error deleting assignments:', data.message || 'Unknown error');
      // Restore row visibility on error
      checkedBoxes.forEach(checkbox => {
        const row = checkbox.closest('tr');
        if (row) {
          row.style.opacity = '1';
          row.style.transform = 'scale(1)';
          row.style.pointerEvents = 'auto';
        }
      });
    }
  })
  .catch(error => {
    console.error('Error:', error);
    alert('❌ Error deleting assignments');
    // Restore row visibility on error
    checkedBoxes.forEach(checkbox => {
      const row = checkbox.closest('tr');
      if (row) {
        row.style.opacity = '1';
        row.style.transform = 'scale(1)';
        row.style.pointerEvents = 'auto';
      }
    });
  })
  .finally(() => {
    button.innerHTML = originalText;
    button.disabled = false;
  });
};

console.log('🌐 Global bulk delete functions defined:', {
  updateDeleteButton: typeof window.updateDeleteButton,
  toggleAll: typeof window.toggleAll,
  bulkDeleteAssignments: typeof window.bulkDeleteAssignments
});

</script>
