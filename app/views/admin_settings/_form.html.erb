<%= form_with(model: admin_setting, local: true, class: "needs-validation", novalidate: true) do |form| %>
  <% if admin_setting.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= pluralize(admin_setting.errors.count, "error") %> prohibited this admin setting from being saved:</h4>
      <ul>
        <% admin_setting.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row">
    <!-- Business Details Section -->
    <div class="col-md-6">
      <div class="card mb-4">
        <div class="card-header">
          <h4><i class="fas fa-building me-2"></i>Brand & Business Details</h4>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <%= form.label :business_name, "Brand Name", class: "form-label" %>
            <%= form.text_field :business_name, class: "form-control", required: true,
                placeholder: "Enter your brand name",
                value: admin_setting.business_name.present? ? admin_setting.business_name : (current_user&.name || AdminSetting.current.business_name) %>
            <small class="form-text text-muted">This will be displayed as your brand name on invoices and documents</small>
          </div>

          <div class="mb-3">
            <%= form.label :address, class: "form-label" %>
            <%= form.text_area :address, rows: 3, class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= form.label :mobile, class: "form-label" %>
            <%= form.text_field :mobile, class: "form-control", required: true %>
          </div>

          <div class="mb-3">
            <%= form.label :email, class: "form-label" %>
            <%= form.email_field :email, class: "form-control", required: true %>
          </div>

          <div class="mb-3">
            <%= form.label :gstin, "GSTIN", class: "form-label" %>
            <%= form.text_field :gstin, class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= form.label :pan_number, "PAN Number", class: "form-label" %>
            <%= form.text_field :pan_number, class: "form-control" %>
          </div>
        </div>
      </div>
    </div>

    <!-- Bank Details Section -->
    <div class="col-md-6">
      <div class="card mb-4">
        <div class="card-header">
          <h4><i class="fas fa-university me-2"></i>Bank Details</h4>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <%= form.label :account_holder_name, class: "form-label" %>
            <%= form.text_field :account_holder_name, class: "form-control", required: true %>
          </div>

          <div class="mb-3">
            <%= form.label :bank_name, class: "form-label" %>
            <%= form.text_field :bank_name, class: "form-control", required: true %>
          </div>

          <div class="mb-3">
            <%= form.label :account_number, class: "form-label" %>
            <%= form.text_field :account_number, class: "form-control", required: true %>
          </div>

          <div class="mb-3">
            <%= form.label :ifsc_code, "IFSC Code", class: "form-label" %>
            <%= form.text_field :ifsc_code, class: "form-control", required: true %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <!-- UPI Payment Section -->
    <div class="col-md-6">
      <div class="card mb-4">
        <div class="card-header">
          <h4><i class="fas fa-mobile-alt me-2"></i>UPI Payment</h4>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <%= form.label :upi_id, "UPI ID", class: "form-label" %>
            <%= form.text_field :upi_id, class: "form-control", placeholder: "yourname@paytm or yourname@upi" %>
            <div class="form-text">Enter your UPI ID to generate QR code automatically</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Terms and Conditions Section -->
    <div class="col-md-6">
      <div class="card mb-4">
        <div class="card-header">
          <h4><i class="fas fa-file-contract me-2"></i>Terms and Conditions</h4>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <%= form.label :terms_and_conditions, class: "form-label" %>
            <%= form.text_area :terms_and_conditions, rows: 5, class: "form-control", placeholder: "Enter terms and conditions for your customers" %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Sidebar Visibility Controls Section -->
  <div class="row">
    <div class="col-md-12">
      <div class="card mb-4">
        <div class="card-header">
          <h4><i class="fas fa-bars me-2"></i>Sidebar Menu Visibility</h4>
          <small class="text-muted">Control which menu items are visible in the sidebar navigation</small>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-3 mb-3">
              <div class="form-check form-switch">
                <%= form.check_box :show_dashboard, class: "form-check-input", checked: admin_setting.show_dashboard? %>
                <%= form.label :show_dashboard, "Dashboard", class: "form-check-label" %>
              </div>
            </div>

            <div class="col-md-3 mb-3">
              <div class="form-check form-switch">
                <%= form.check_box :show_orders, class: "form-check-input", checked: admin_setting.show_orders? %>
                <%= form.label :show_orders, "Orders", class: "form-check-label" %>
              </div>
            </div>

            <div class="col-md-3 mb-3">
              <div class="form-check form-switch">
                <%= form.check_box :show_customers, class: "form-check-input", checked: admin_setting.show_customers? %>
                <%= form.label :show_customers, "Customers", class: "form-check-label" %>
              </div>
            </div>

            <div class="col-md-3 mb-3">
              <div class="form-check form-switch">
                <%= form.check_box :show_products, class: "form-check-input", checked: admin_setting.show_products? %>
                <%= form.label :show_products, "Products", class: "form-check-label" %>
              </div>
            </div>

            <div class="col-md-3 mb-3">
              <div class="form-check form-switch">
                <%= form.check_box :show_categories, class: "form-check-input", checked: admin_setting.show_categories? %>
                <%= form.label :show_categories, "Categories", class: "form-check-label" %>
              </div>
            </div>

            <div class="col-md-3 mb-3">
              <div class="form-check form-switch">
                <%= form.check_box :show_delivery_assignments, class: "form-check-input", checked: admin_setting.show_delivery_assignments? %>
                <%= form.label :show_delivery_assignments, "Deliveries", class: "form-check-label" %>
              </div>
            </div>

            <div class="col-md-3 mb-3">
              <div class="form-check form-switch">
                <%= form.check_box :show_invoices, class: "form-check-input", checked: admin_setting.show_invoices? %>
                <%= form.label :show_invoices, "Invoices", class: "form-check-label" %>
              </div>
            </div>

            <div class="col-md-3 mb-3">
              <div class="form-check form-switch">
                <%= form.check_box :show_milk_analytics, class: "form-check-input", checked: admin_setting.show_milk_analytics? %>
                <%= form.label :show_milk_analytics, "Milk Analytics", class: "form-check-label" %>
              </div>
            </div>

            <div class="col-md-3 mb-3">
              <div class="form-check form-switch">
                <%= form.check_box :show_procurement, class: "form-check-input", checked: admin_setting.show_procurement? %>
                <%= form.label :show_procurement, "Procurement", class: "form-check-label" %>
              </div>
            </div>

            <div class="col-md-3 mb-3">
              <div class="form-check form-switch">
                <%= form.check_box :show_payouts, class: "form-check-input", checked: admin_setting.show_payouts? %>
                <%= form.label :show_payouts, "Payouts", class: "form-check-label" %>
              </div>
            </div>

            <div class="col-md-3 mb-3">
              <div class="form-check form-switch">
                <%= form.check_box :show_reports, class: "form-check-input", checked: admin_setting.show_reports? %>
                <%= form.label :show_reports, "Reports", class: "form-check-label" %>
              </div>
            </div>

            <div class="col-md-3 mb-3">
              <div class="form-check form-switch">
                <%= form.check_box :show_users, class: "form-check-input", checked: admin_setting.show_users? %>
                <%= form.label :show_users, "Users", class: "form-check-label" %>
              </div>
            </div>
          </div>

          <div class="alert alert-info mt-3">
            <i class="fas fa-info-circle me-2"></i>
            <strong>Note:</strong> Changes to sidebar visibility will take effect immediately after saving.
            The Settings menu cannot be hidden to ensure you can always access this page.
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-12">
      <div class="card">
        <div class="card-body text-center">
          <div class="actions">
            <%= form.submit class: "btn btn-primary btn-lg me-2" %>
            <%= link_to "Cancel", admin_settings_path, class: "btn btn-secondary btn-lg" %>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>

<script>
// Bootstrap form validation
(function() {
  'use strict';
  window.addEventListener('load', function() {
    var forms = document.getElementsByClassName('needs-validation');
    var validation = Array.prototype.filter.call(forms, function(form) {
      form.addEventListener('submit', function(event) {
        if (form.checkValidity() === false) {
          event.preventDefault();
          event.stopPropagation();
        }
        form.classList.add('was-validated');
      }, false);
    });
  }, false);
})();
</script>