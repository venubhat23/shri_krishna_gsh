<div class="container-fluid py-4">
  <div class="row">
    <div class="col-12">
      <div class="card shadow">
        <div class="card-header bg-primary text-white">
          <div class="d-flex align-items-center">
            <i class="fas fa-bars me-3 fs-4"></i>
            <div>
              <h4 class="mb-0">Sidebar Configuration</h4>
              <small class="opacity-75">Control which menu items appear in the sidebar navigation</small>
            </div>
          </div>
        </div>

        <div class="card-body">
          <%= form_with(model: @admin_setting, url: sidebar_configurations_path, method: :patch, local: true, class: "needs-validation") do |form| %>
            <% if @admin_setting.errors.any? %>
              <div class="alert alert-danger">
                <h5><%= pluralize(@admin_setting.errors.count, "error") %> prohibited saving:</h5>
                <ul class="mb-0">
                  <% @admin_setting.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <!-- Current Status Overview -->
            <div class="row mb-4">
              <div class="col-md-6">
                <div class="card bg-light">
                  <div class="card-body text-center">
                    <h5 class="text-primary">
                      <i class="fas fa-eye text-success"></i>
                      <%= @visible_items.except(:settings).count %>
                    </h5>
                    <small class="text-muted">Visible Menu Items</small>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="card bg-light">
                  <div class="card-body text-center">
                    <h5 class="text-secondary">
                      <i class="fas fa-eye-slash text-warning"></i>
                      <%= @sidebar_items.except(:settings).count - @visible_items.except(:settings).count %>
                    </h5>
                    <small class="text-muted">Hidden Menu Items</small>
                  </div>
                </div>
              </div>
            </div>

            <!-- Menu Items Configuration -->
            <div class="row">
              <div class="col-12">
                <h5 class="mb-3">
                  <i class="fas fa-list-ul me-2"></i>
                  Menu Items Configuration
                </h5>
                <p class="text-muted mb-4">
                  Toggle the switches below to show or hide menu items in the sidebar.
                  Changes will take effect immediately after saving.
                </p>
              </div>
            </div>

            <div class="row">
              <% @sidebar_items.each_with_index do |(key, item), index| %>
                <% next if key == :settings %> <!-- Settings is always visible and not configurable -->
                <div class="col-md-6 col-lg-4 mb-3">
                  <div class="card h-100 <%= item[:show] ? 'border-success' : 'border-secondary' %>">
                    <div class="card-body">
                      <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="d-flex align-items-center">
                          <i class="<%= item[:icon] %> me-2 text-primary"></i>
                          <strong><%= item[:name] %></strong>
                        </div>
                        <div class="form-check form-switch">
                          <%= form.check_box "show_#{key}".to_sym,
                              class: "form-check-input",
                              checked: item[:show],
                              id: "show_#{key}" %>
                          <%= form.label "show_#{key}".to_sym, "",
                              class: "form-check-label",
                              for: "show_#{key}" %>
                        </div>
                      </div>
                      <div class="small text-muted">
                        <strong>Path:</strong> <%= item[:path] %>
                      </div>
                      <div class="small">
                        <% if item[:show] %>
                          <span class="badge bg-success">
                            <i class="fas fa-eye me-1"></i>
                            Visible
                          </span>
                        <% else %>
                          <span class="badge bg-secondary">
                            <i class="fas fa-eye-slash me-1"></i>
                            Hidden
                          </span>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>

            <!-- Actions -->
            <div class="row mt-4">
              <div class="col-12">
                <div class="card bg-light">
                  <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                      <div>
                        <h6 class="mb-1">Ready to apply changes?</h6>
                        <small class="text-muted">Changes will take effect immediately after saving.</small>
                      </div>
                      <div>
                        <%= form.submit "Save Configuration",
                            class: "btn btn-primary btn-lg me-2" %>
                        <%= link_to "Back to Settings",
                            admin_settings_path,
                            class: "btn btn-outline-secondary" %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Quick Actions Card -->
<div class="row mt-4">
  <div class="col-12">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <h6 class="text-muted">Quick Actions</h6>
        <div class="btn-group" role="group">
          <button type="button"
                  class="btn btn-outline-success btn-sm"
                  onclick="enableAll()">
            <i class="fas fa-check-double me-1"></i>
            Enable All
          </button>
          <button type="button"
                  class="btn btn-outline-warning btn-sm"
                  onclick="disableAll()">
            <i class="fas fa-times me-1"></i>
            Disable All
          </button>
          <button type="button"
                  class="btn btn-outline-info btn-sm"
                  onclick="resetToDefaults()">
            <i class="fas fa-undo me-1"></i>
            Reset to Defaults
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function enableAll() {
  const checkboxes = document.querySelectorAll('input[type="checkbox"]:not([disabled])');
  checkboxes.forEach(checkbox => {
    checkbox.checked = true;
    updateCardStyle(checkbox);
  });
}

function disableAll() {
  const checkboxes = document.querySelectorAll('input[type="checkbox"]:not([disabled])');
  checkboxes.forEach(checkbox => {
    checkbox.checked = false;
    updateCardStyle(checkbox);
  });
}

function resetToDefaults() {
  const checkboxes = document.querySelectorAll('input[type="checkbox"]:not([disabled])');
  checkboxes.forEach(checkbox => {
    checkbox.checked = true; // Default is all enabled
    updateCardStyle(checkbox);
  });
}

function updateCardStyle(checkbox) {
  const card = checkbox.closest('.card');
  const badge = card.querySelector('.badge');

  if (checkbox.checked) {
    card.classList.remove('border-secondary');
    card.classList.add('border-success');
    badge.className = 'badge bg-success';
    badge.innerHTML = '<i class="fas fa-eye me-1"></i>Visible';
  } else {
    card.classList.remove('border-success');
    card.classList.add('border-secondary');
    badge.className = 'badge bg-secondary';
    badge.innerHTML = '<i class="fas fa-eye-slash me-1"></i>Hidden';
  }
}

// Add event listeners to update card styles when checkboxes change
document.addEventListener('DOMContentLoaded', function() {
  const checkboxes = document.querySelectorAll('input[type="checkbox"]:not([disabled])');
  checkboxes.forEach(checkbox => {
    checkbox.addEventListener('change', function() {
      updateCardStyle(this);
      updateCounts();
    });
  });
});

function updateCounts() {
  const visibleCount = document.querySelectorAll('input[type="checkbox"]:checked:not([disabled])').length;
  const totalCount = document.querySelectorAll('input[type="checkbox"]:not([disabled])').length;
  const hiddenCount = totalCount - visibleCount;

  // Update the count cards
  const visibleCountElement = document.querySelector('.text-success').closest('h5');
  const hiddenCountElement = document.querySelector('.text-warning').closest('h5');

  if (visibleCountElement) {
    visibleCountElement.innerHTML = `<i class="fas fa-eye text-success"></i> ${visibleCount}`;
  }
  if (hiddenCountElement) {
    hiddenCountElement.innerHTML = `<i class="fas fa-eye-slash text-warning"></i> ${hiddenCount}`;
  }
}
</script>