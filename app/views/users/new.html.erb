<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up - <%= AdminSetting.current.business_name %></title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.1.3/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            height: 100%;
            min-height: 100vh;
        }

        /* Main Container with Beautiful Blue Gradient */
        .login-wrapper {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 35%, #1e40af 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        /* Login Card */
        .login-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            border-radius: 24px;
            box-shadow:
                0 25px 50px rgba(0, 0, 0, 0.25),
                0 0 0 1px rgba(255, 255, 255, 0.05);
            padding: 48px 40px;
            width: 100%;
            max-width: 480px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .login-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.8), transparent);
        }

        /* Logo Container */
        .logo-container {
            width: 120px;
            height: 120px;
            margin: 0 auto 24px;
            border-radius: 20px;
            background: linear-gradient(135deg, #3b82f6 0%, #1e40af 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 32px rgba(59, 130, 246, 0.3);
            position: relative;
        }

        .logo-container::before {
            content: '';
            position: absolute;
            inset: 2px;
            border-radius: 18px;
            background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .logo-image {
            width: 90px;
            height: 90px;
            border-radius: 14px;
            object-fit: cover;
            position: relative;
            z-index: 1;
        }

        /* Title Section */
        .title-section {
            margin-bottom: 32px;
        }

        .main-title {
            font-size: 28px;
            font-weight: 700;
            color: #1f2937;
            margin-bottom: 8px;
            letter-spacing: -0.5px;
        }

        .subtitle {
            font-size: 16px;
            color: #6b7280;
            font-weight: 500;
        }

        /* Form Styles */
        .login-form {
            width: 100%;
        }

        .form-group {
            margin-bottom: 20px;
            text-align: left;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 20px;
        }

        .form-control {
            width: 100%;
            padding: 16px 20px;
            font-size: 16px;
            border: 2px solid #e5e7eb;
            border-radius: 12px;
            background: #f9fafb;
            color: #1f2937;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .form-control::placeholder {
            color: #9ca3af;
            font-weight: 400;
        }

        .form-control:focus {
            outline: none;
            border-color: #3b82f6;
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }

        /* Login Button */
        .login-button {
            width: 100%;
            padding: 16px;
            font-size: 16px;
            font-weight: 600;
            color: white;
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            border: none;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.2s ease;
            margin-top: 8px;
            box-shadow: 0 4px 16px rgba(245, 158, 11, 0.3);
        }

        .login-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(245, 158, 11, 0.4);
            background: linear-gradient(135deg, #d97706 0%, #b45309 100%);
        }

        .login-button:active {
            transform: translateY(0);
        }

        /* Sign In Link Section */
        .signin-section {
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px solid #e5e7eb;
            text-align: center;
        }

        .signin-text {
            color: #6b7280;
            font-size: 14px;
            margin-bottom: 12px;
            font-weight: 500;
        }

        .signin-button {
            display: inline-block;
            padding: 12px 24px;
            font-size: 14px;
            font-weight: 600;
            color: #3b82f6;
            background: rgba(59, 130, 246, 0.1);
            border: 2px solid #3b82f6;
            border-radius: 8px;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .signin-button:hover {
            background: #3b82f6;
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
            text-decoration: none;
        }

        .signin-button:active {
            transform: translateY(0);
        }

        /* Copyright Footer */
        .copyright {
            position: absolute;
            bottom: 24px;
            left: 0;
            right: 0;
            text-align: center;
            font-size: 14px;
            color: rgba(255, 255, 255, 0.8);
            font-weight: 500;
        }

        /* Flash Messages */
        .alert {
            padding: 12px 16px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 14px;
            font-weight: 500;
        }

        .alert-danger {
            background: rgba(239, 68, 68, 0.1);
            color: #dc2626;
            border: 1px solid rgba(239, 68, 68, 0.2);
        }

        .alert-success {
            background: rgba(34, 197, 94, 0.1);
            color: #16a34a;
            border: 1px solid rgba(34, 197, 94, 0.2);
        }

        /* Mobile Responsive */
        @media (max-width: 768px) {
            .login-wrapper {
                padding: 16px;
            }

            .login-card {
                padding: 32px 24px;
                border-radius: 20px;
            }

            .logo-container {
                width: 100px;
                height: 100px;
                margin-bottom: 20px;
            }

            .logo-image {
                width: 75px;
                height: 75px;
            }

            .main-title {
                font-size: 24px;
            }

            .subtitle {
                font-size: 14px;
            }

            .form-control {
                padding: 14px 16px;
                font-size: 15px;
            }

            .login-button {
                padding: 14px;
                font-size: 15px;
            }

            .form-row {
                grid-template-columns: 1fr;
                gap: 16px;
            }
        }

        @media (max-width: 480px) {
            .login-card {
                padding: 24px 20px;
                border-radius: 16px;
            }

            .logo-container {
                width: 80px;
                height: 80px;
            }

            .logo-image {
                width: 60px;
                height: 60px;
            }

            .main-title {
                font-size: 22px;
            }
        }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <div class="login-card">
            <!-- Logo Section -->
            <div class="logo-container">
                <img src="/Lord-Krishna-In-a-Forest-With-Cow-Natural-Image.jpg" alt="Krishna Logo" class="logo-image">
            </div>

            <!-- Title Section -->
            <div class="title-section">
                <h1 class="main-title">Join <%= AdminSetting.current.business_name %></h1>
                <p class="subtitle">Create your admin account</p>
            </div>

            <!-- Sign Up Form -->
            <%= form_with model: @user, url: signup_path, method: :post, local: true, class: "login-form" do |form| %>
                <% if @user && @user.errors.any? %>
                    <div class="alert alert-danger">
                        <% @user.errors.full_messages.each do |message| %>
                            <div><%= message %></div>
                        <% end %>
                    </div>
                <% end %>

                <% if flash[:alert] %>
                    <div class="alert alert-danger">
                        <%= flash[:alert] %>
                    </div>
                <% end %>

                <% if flash[:notice] %>
                    <div class="alert alert-success">
                        <%= flash[:notice] %>
                    </div>
                <% end %>

                <div class="form-row">
                    <div class="form-group">
                        <%= form.text_field :name,
                            class: "form-control",
                            placeholder: "Full Name",
                            required: true %>
                    </div>

                    <div class="form-group">
                        <%= form.email_field :email,
                            class: "form-control",
                            placeholder: "Email Address",
                            required: true %>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <%= form.telephone_field :phone,
                            class: "form-control",
                            placeholder: "Phone Number" %>
                    </div>

                    <div class="form-group">
                        <%= form.select :role, options_for_select([
                            ['Admin', 'admin'],
                            ['Delivery Person', 'delivery_person'],
                            ['User', 'user']
                        ], @user&.role), { prompt: 'Select Role' }, { class: "form-control", required: true } %>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <%= form.password_field :password,
                            class: "form-control",
                            placeholder: "Password",
                            required: true %>
                    </div>

                    <div class="form-group">
                        <%= form.password_field :password_confirmation,
                            class: "form-control",
                            placeholder: "Confirm Password",
                            required: true %>
                    </div>
                </div>

                <%= form.submit "Create Account", class: "login-button" %>
            <% end %>

            <!-- Sign In Link -->
            <div class="signin-section">
                <p class="signin-text">Already have an account?</p>
                <%= link_to "Sign In", login_path, class: "signin-button" %>
            </div>
        </div>

        <!-- Copyright Footer -->
        <div class="copyright">
            © 2025 <%= AdminSetting.current.business_name %>
        </div>
    </div>
</body>
</html>